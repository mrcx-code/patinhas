# Copie para .env e preencha. O .env está no .gitignore — nunca comite.

# Do painel do app em developers.facebook.com → Instagram → Configuração da API
IG_APP_ID=
IG_APP_SECRET=

# Precisa bater EXATAMENTE com o cadastrado no painel (inclusive a barra final, se houver)
IG_REDIRECT_URI=https://SEU-SITE.vercel.app/oauth/instagram

# Preenchidos automaticamente por `node auth.mjs exchange <code>`
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_TOKEN_EXPIRES_AT=

# Opcional — versão da Graph API. Suba quando a Meta lançar uma nova.
IG_API_VERSION=v23.0
