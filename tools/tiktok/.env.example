# Copie para .env e preencha. O .env está no .gitignore — nunca comite.

# Do painel do app em developers.tiktok.com → Manage apps → seu app → "Keys"
TT_CLIENT_KEY=
TT_CLIENT_SECRET=

# Precisa bater EXATAMENTE com o Redirect URI cadastrado no painel (Login Kit).
# Pode ser qualquer HTTPS que você controle; não precisa existir de verdade.
TT_REDIRECT_URI=https://patinhasbrasil.com.br/oauth/tiktok

# Preenchidos automaticamente por `node auth.mjs exchange <code>`
TT_ACCESS_TOKEN=
TT_REFRESH_TOKEN=
TT_ACCESS_EXPIRES_AT=
TT_REFRESH_EXPIRES_AT=
TT_OPEN_ID=
TT_SCOPE=

# Uso interno do fluxo OAuth com PKCE (gerados/limpos pelo auth.mjs) — deixe vazio
TT_PKCE_VERIFIER=
TT_OAUTH_STATE=
